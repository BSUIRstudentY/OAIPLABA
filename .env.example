# Copy to .env and adjust as needed:  cp .env.example .env
# All values have sensible development defaults in docker-compose.yml.

# Postgres
POSTGRES_DB=vidvault
POSTGRES_USER=vidvault
POSTGRES_PASSWORD=vidvault
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vidvault-videos
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Browser-reachable endpoint used to sign video download URLs.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Backend
BACKEND_PORT=8080
JWT_SECRET=change-me-in-production-this-is-a-long-dev-only-secret-key-1234567890
ADMIN_EMAIL=admin@vidvault.io
ADMIN_PASSWORD=admin12345
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# Frontend (served by nginx)
FRONTEND_PORT=8081
